# ---- DÙNG CHUNG với dự án Luyện thi CNTT UTC (cùng database người dùng) ----
MONGODB_URI=mongodb+srv://...            # CÙNG chuỗi kết nối với dự án cũ → cùng collection users/otps
# ---- riêng của repository-mnha ----
PORT=3000
SESSION_SECRET=doi-chuoi-nay
# Session CHỈ lưu ở GitHub: cookies/index.json (repo PHẢI để private), mã hoá AES-256-GCM — không còn ghi session vào MongoDB
SESSION_ENC_KEY=                         # ≥ 32 ký tự ngẫu nhiên, bí mật. MẤT/ĐỔI khoá = session cũ không giải mã được (đăng nhập lại)
# SESSION_INDEX_PATH=cookies/index.json
NODE_ENV=production
# GitHub nơi lưu {user_id}/codes/... và {user_id}/result/... (repo/token riêng hoặc dùng chung đều được)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
# Gửi OTP đăng ký (dùng cùng SMTP với dự án cũ được)
MAIL_USER=
MAIL_PASS=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
# Trình biên dịch C++ (Windows/Dev-C++: đường dẫn g++.exe của MinGW)
CPP_COMPILER=g++
# Chạy C++ qua dịch vụ runner riêng (Docker có g++ — xem runner/). Đặt cả 2 biến ở web chính (Vercel).
# CPP_RUNNER_URL=https://mnha-cpp-runner.onrender.com
# CPP_RUNNER_KEY=chuoi-bi-mat-it-nhat-16-ky-tu    # phải TRÙNG với CPP_RUNNER_KEY đặt ở dịch vụ runner
# --- HTML + CSS: ảnh/âm thanh/video mã hoá (xem CODE.md). Đều không bắt buộc ---
# Khoá chủ mã hoá media (≥ 32 ký tự). Bỏ trống = suy ra từ SESSION_ENC_KEY. ĐỔI KHOÁ = media đã mã hoá không giải mã được nữa.
# MEDIA_ENC_KEY=
# Dung lượng tối đa mỗi file tải lên (byte), mặc định 2GB
# MEDIA_MAX_BYTES=2147483648
# Trình duyệt TỰ giải mã: tải file mã hoá thẳng từ GitHub raw (repo PHẢI công khai), chỉ xin khoá nhỏ ở máy chủ → không tốn Fast Origin Transfer của Vercel.
# Đặt off = mọi thứ qua máy chủ như trước (repo private, hoặc muốn tắt). Repo private mà không đặt off: trình duyệt gặp 404 từ raw rồi tự quay về đường máy chủ.
# MEDIA_DIRECT=off
# Địa chỉ gốc để tải thẳng (mặc định https://raw.githubusercontent.com/<GITHUB_OWNER>/<GITHUB_REPO>/<GITHUB_BRANCH>); đổi nếu dùng CDN/mirror
# MEDIA_RAW_BASE=
# Nguồn hls.js để phát m3u8 (mặc định jsDelivr, đã ghim phiên bản)
# HLSJS_URL=
# ---- NHIỀU WEB DỮ LIỆU (Vercel khác) — xem CODE.md mục "Web kết nối" ----
# Web chính: DATA_NODE=off. Mỗi web dữ liệu: DATA_NODE=on + NODE_ID / NODE_URL / NODE_NAME.
# DATA_NODE=off
# NODE_ID=repository-mnha-data-1
# NODE_URL=https://repository-mnha-data-1.vercel.app
# NODE_NAME=Web dữ liệu 1
# Khoá mã hoá 2 chiều cho khoá kết nối + HMAC ký phiếu tải lên (≥ 32 ký tự, GIỐNG HỆT mọi web).
# CONNECT_ENC_KEY=
# CONNECT_HMAC_KEY=
# CONNECT_INDEX_PATH=v-s/index.json
# CONNECT_USAGE_PATH=v-s/usage.json
# CONNECT_PROBE_TIMEOUT_MS=4000
# UPLOAD_TOKEN_TTL_MS=7200000
# Không có web dữ liệu nào sống: on = tải lên máy chủ chính; off = báo lỗi (503).
# CONNECT_FALLBACK_LOCAL=on
# CONNECT_REQUIRED=off
# Địa chỉ web chính (hiện trong .env mẫu ở /connect).
# MAIN_URL=https://repository-mnha.vercel.app
# Tự tạo repo media mới khi repo đang dùng đạt ~500MB (mnha-media.json vẫn ở repo chính).
# MEDIA_REPO_POOL=on
# MEDIA_REPO_LIMIT_BYTES=524288000
# MEDIA_REPO_INDEX_PATH=v-s/media-repos.json
# GITHUB_MEDIA_TOKEN=          # cần quyền tạo repo; có thể trùng GITHUB_TOKEN
# GITHUB_MEDIA_OWNER=          # mặc định = GITHUB_OWNER
# GITHUB_MEDIA_REPO_PREFIX=repository-mnha-media     # hoặc repository-mnha-media-{ts} → theo thời gian YYYYMMDD-HHmmss
# MEDIA_REPO_PRIVATE=off
# ---- CLOUDFLARE R2 cho video / âm thanh (ảnh vẫn tải lên GitHub) — xem guide/connect-cloudflare.md ----
# Cấu hình (Account ID, bucket, Access Key, Secret, token GitHub dự phòng) lưu MÃ HOÁ trong v-s/cloudflare.json
# qua trang /connect của web chính. Các biến dưới chỉ đổi đường dẫn / chế độ.
# CLOUDFLARE_INDEX_PATH=v-s/cloudflare.json
# on = KHÔNG cho ghi video/âm thanh mới vào GitHub khi chưa cấu hình R2/dự phòng (khuyến nghị khi tài khoản media đã khoá)
# CLOUDFLARE_REQUIRED=off
