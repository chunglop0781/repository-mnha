doctype html
html(lang="vi")
    head
        meta(charset="utf-8")
        meta(name="viewport", content="width=device-width, initial-scale=1")
        title #{title || 'repository-mnha'} · repository-mnha
        script(src="https://cdn.tailwindcss.com")
        script(src="https://unpkg.com/lucide@latest")
    body(class="bg-gray-50 text-gray-900")
        header(class="h-14 bg-white border-b border-gray-200 flex items-center justify-between px-4 sm:px-6")
            a(href="/", class="flex items-center gap-2 font-bold text-indigo-600")
                i(data-lucide="terminal-square", class="w-5 h-5")
                | repository-mnha
            if user
                div(class="flex items-center gap-4 text-sm")
                    span(class="text-gray-600")= user.name
                    form(method="post", action="/auth/logout")
                        button(type="submit", class="text-gray-500 hover:text-red-600") Đăng xuất
        block content
        script.
            if (window.lucide) lucide.createIcons();
