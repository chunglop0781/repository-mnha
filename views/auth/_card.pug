mixin field(label, name, type, value, extra)
    div
        label(class="block text-sm font-medium text-gray-700 mb-1", for=name)= label
        if type === "password"
            div(class="relative")
                input(id=name, name=name, type="password", value=value, required, class="w-full rounded-lg border border-gray-300 pl-3 pr-11 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500", autocomplete=extra)
                button(type="button", data-toggle-password=name, aria-label="Hiện mật khẩu", aria-pressed="false", tabindex="-1", class="absolute inset-y-0 right-0 px-3 text-gray-400 hover:text-gray-600 focus:outline-none")
                    svg(data-eye-on xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2")
                        path(stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z")
                        circle(cx="12" cy="12" r="3")
                    svg(data-eye-off hidden xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2")
                        path(stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88L3 3m6.878 6.878L21 21M6.1 6.1A9.97 9.97 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.05 10.05 0 01-4.132 5.411")
        else
            input(id=name, name=name, type=type, value=value, required, class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500", autocomplete=extra)

mixin passwordToggleScript
    script.
        document.querySelectorAll('[data-toggle-password]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var input = document.getElementById(btn.getAttribute('data-toggle-password'));
            var show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            btn.setAttribute('aria-pressed', show);
            btn.setAttribute('aria-label', show ? 'Ẩn mật khẩu' : 'Hiện mật khẩu');
            btn.querySelector('[data-eye-on]').hidden = show;
            btn.querySelector('[data-eye-off]').hidden = !show;
          });
        });
