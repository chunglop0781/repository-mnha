extends ../layout

block content
    - var base = "/code/" + lang.key
    - var parts = dir ? dir.split("/") : []
    div(class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8", id="codeFiles", data-lang=lang.key, data-dir=dir, data-exts=lang.exts.join(","), data-max=(lang.maxFileBytes ? Math.min(lang.maxFileBytes, 3 * 1024 * 1024) : 200 * 1024))
        a(href="/", class="text-sm text-indigo-600 hover:underline inline-flex items-center gap-1")
            i(data-lucide="arrow-left", class="w-4 h-4")
            | Chọn ngôn ngữ
        h1(class="mt-3 text-2xl font-bold text-gray-900")= lang.name
        //- đường dẫn
        nav(class="mt-2 text-sm text-gray-600 flex flex-wrap items-center gap-1")
            a(href=base, class="text-indigo-600 hover:underline") codes/#{lang.key}
            each p, i in parts
                span /
                a(href=base + "?dir=" + encodeURIComponent(parts.slice(0, i + 1).join("/")), class="text-indigo-600 hover:underline")= p
        div(class="mt-5 flex flex-wrap gap-3")
            button(id="btnNewFile", class="px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700") + File mới
            button(id="btnNewFolder", class="px-4 py-2 rounded-lg bg-white border border-gray-300 text-sm font-medium hover:bg-gray-50") + Thư mục mới
            a(href=base + "/history", class="px-4 py-2 rounded-lg bg-white border border-gray-300 text-sm font-medium hover:bg-gray-50 inline-flex items-center gap-1")
                i(data-lucide="history", class="w-4 h-4")
                | Lịch sử chạy code
            a(href=base + "/online", class="px-4 py-2 rounded-lg bg-white border border-emerald-300 text-emerald-700 text-sm font-medium hover:bg-emerald-50 inline-flex items-center gap-1")
                i(data-lucide="globe", class="w-4 h-4")
                | Xem tệp code / Đọc thư mục trên mạng
            button(type="button", id="btnUploadText", class="px-4 py-2 rounded-lg bg-white border border-indigo-300 text-indigo-700 text-sm font-medium hover:bg-indigo-50 inline-flex items-center gap-1")
                i(data-lucide="upload", class="w-4 h-4")
                | Tải file text lên
            button(type="button", id="btnDownloadAll", class="px-4 py-2 rounded-lg bg-white border border-indigo-300 text-indigo-700 text-sm font-medium hover:bg-indigo-50 inline-flex items-center gap-1")
                i(data-lucide="download", class="w-4 h-4")
                | Tải tất cả file text về
            input(type="file", id="textUploadInput", multiple, class="hidden", accept=lang.exts.map(function (e) { return "." + e; }).join(","))
            if dir
                button(type="button", id="btnRenFolder", data-rename=dir, class="px-4 py-2 rounded-lg bg-white border border-gray-300 text-sm font-medium hover:bg-gray-50") Đổi tên
            if dir
                button(id="btnDelFolder", class="px-4 py-2 rounded-lg bg-white border border-red-300 text-red-600 text-sm font-medium hover:bg-red-50") Xoá thư mục này
        if shareUrl
            div(class="mt-4 flex items-center gap-2 text-sm bg-white border border-gray-200 rounded-xl px-3 py-2")
                i(data-lucide="github", class="w-4 h-4 shrink-0 text-gray-600")
                span(class="text-gray-600 whitespace-nowrap") Link GitHub của thư mục này (để chia sẻ):
                a(id="ghFolderLink", href=shareUrl, target="_blank", rel="noopener noreferrer", class="flex-1 min-w-0 truncate text-indigo-600 hover:underline font-mono text-xs")= shareUrl
                button(type="button", id="btnCopyFolderLink", class="px-3 py-1 rounded-lg bg-gray-100 text-xs font-medium hover:bg-gray-200 whitespace-nowrap") Sao chép
        p(class="mt-2 text-xs text-gray-500")
            if lang.exts.includes("txt")
                | File .cpp chạy được; file .txt dùng cho freopen (input.txt / output.txt) — các .txt cùng thư mục được nạp sẵn khi chạy. Header .h/.hpp cùng thư mục dùng được qua #include "ten.hpp" (x.hpp có x.cpp đi kèm thì tự biên dịch cùng).
            else
                | Thư mục chỉ tạo được bên trong codes/#{lang.key}/.
        div(class="mt-5 bg-white rounded-2xl border border-gray-200 divide-y divide-gray-100")
            if dir
                - var up = parts.slice(0, -1).join("/")
                a(href=base + (up ? "?dir=" + encodeURIComponent(up) : ""), class="flex items-center gap-3 px-4 py-3 hover:bg-gray-50 text-gray-600")
                    i(data-lucide="corner-left-up", class="w-4 h-4")
                    | ..
            each f in folders
                div(class="flex items-center gap-3 px-4 py-3 hover:bg-gray-50")
                    i(data-lucide="folder", class="w-4 h-4 text-amber-500")
                    a(href=base + "?dir=" + encodeURIComponent((dir ? dir + "/" : "") + f), class="flex-1 font-medium text-gray-900 hover:text-indigo-600")= f
                    button(type="button", class="text-xs text-indigo-600 hover:underline", data-rename=(dir ? dir + "/" : "") + f) Đổi tên
            each f in files
                div(class="flex items-center gap-3 px-4 py-3 hover:bg-gray-50")
                    i(data-lucide="file-code-2", class="w-4 h-4 text-indigo-500")
                    a(href=base + "/edit?dir=" + encodeURIComponent(dir) + "&file=" + encodeURIComponent(f), target="_blank", rel="noopener", class="flex-1 text-gray-900 hover:text-indigo-600")= f
                    a(href=base + "/download?dir=" + encodeURIComponent(dir) + "&file=" + encodeURIComponent(f), download=f, class="text-xs text-gray-600 hover:underline") Tải
                    button(type="button", class="text-xs text-indigo-600 hover:underline", data-rename-file=f) Đổi tên
                    button(class="btn-del-file text-xs text-red-500 hover:underline", data-file=f) Xoá
            if !folders.length && !files.length
                div(class="px-4 py-10 text-center text-gray-500 text-sm") Thư mục trống. Hãy tạo file hoặc thư mục mới.
    script(src="/js/codeFiles.js")
    script(src="/js/folderTools.js")
    script(src="/js/zipKit.js")
    script(src="/js/textTransfer.js")
