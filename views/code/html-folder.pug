extends ../layout

block content
    link(rel="stylesheet", href="/css/html.css")
    - function fmt(n) { return n == null ? "" : n < 1024 ? n + " B" : n < 1048576 ? (n / 1024).toFixed(1) + " KB" : (n / 1048576).toFixed(1) + " MB" }
    div(class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8")
        a(href="/code/html/online", class="text-sm text-indigo-600 hover:underline inline-flex items-center gap-1")
            i(data-lucide="arrow-left", class="w-4 h-4")
            | Xem code trên mạng
        h1(class="mt-3 text-2xl font-bold text-gray-900") Xem thư mục trên mạng
        nav(class="mt-2 text-sm text-gray-600 flex flex-wrap items-center gap-1")
            each c, i in crumbs
                if i
                    span /
                a(href=c.href, class="text-indigo-600 hover:underline break-all")= c.name
        div(class="mt-4 flex flex-wrap gap-3")
            if hasMedia
                a(href=playUrl, class="px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700 inline-flex items-center gap-1")
                    i(data-lucide="play-circle", class="w-4 h-4")
                    | Trình phát ảnh / âm thanh / video
            a(href=web, target="_blank", rel="noopener noreferrer", class="px-4 py-2 rounded-lg bg-white border border-gray-300 text-sm font-medium hover:bg-gray-50") Mở trên #{host}
        div(class="mt-5 bg-white rounded-2xl border border-gray-200 divide-y divide-gray-100")
            if !list.length
                div(class="px-4 py-10 text-center text-gray-500 text-sm") Thư mục trống.
            each x in list
                if x.type === "dir"
                    a(href=x.href, class="flex items-center gap-3 px-4 py-3 hover:bg-gray-50")
                        i(data-lucide="folder", class="w-4 h-4 text-amber-500")
                        span(class="font-medium text-gray-900 break-all")= x.name
                else
                    div(class="flex items-center gap-3 px-4 py-3 hover:bg-gray-50")
                        i(data-lucide=x.kind === "page" ? "layout-template" : x.kind === "text" ? "file-code-2" : x.kind === "image" ? "image" : x.kind === "audio" ? "music" : x.kind === "video" ? "film" : "file", class="w-4 h-4 text-gray-500")
                        if x.href
                            a(href=x.href, class="flex-1 text-gray-900 hover:text-indigo-600 break-all")= x.name
                        else
                            span(class="flex-1 text-gray-400 break-all", title="File này không xem được ở đây")= x.name
                        if x.kind === "page"
                            a(href=x.href + "#view", class="text-xs text-emerald-600 hover:underline") Xem trang
                        if x.kind === "image" || x.kind === "audio" || x.kind === "video"
                            span(class="asset-pill " + x.kind)= x.kind === "image" ? "ảnh" : x.kind === "audio" ? "âm thanh" : "video"
                            if x.cut
                                span(class="text-xs text-gray-500", title="Đã cắt m3u8 (khai báo trong mnha-media.json)") m3u8
                        span(class="text-xs text-gray-400 whitespace-nowrap")= fmt(x.size)
        if truncated
            p(class="mt-2 text-xs text-amber-600") Chỉ hiện 300 mục đầu tiên.
    script.
        if (window.lucide) lucide.createIcons();
