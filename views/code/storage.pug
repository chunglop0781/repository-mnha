extends ../layout

block content
    - var base = "/code/files"
    - var parts = dir ? dir.split("/") : []
    - var KIND = { word: ["Word", "text-blue-600 bg-blue-50", "file-text"], excel: ["Excel", "text-emerald-700 bg-emerald-50", "file-spreadsheet"], powerpoint: ["PowerPoint", "text-orange-600 bg-orange-50", "presentation"], office: ["Office", "text-indigo-600 bg-indigo-50", "file"], pdf: ["PDF", "text-red-600 bg-red-50", "file-text"], text: ["Văn bản", "text-slate-700 bg-slate-100", "file-text"], image: ["Ảnh", "text-purple-600 bg-purple-50", "image"] }
    - function fmt(n) { return n >= 1048576 ? (n / 1048576).toFixed(n >= 10485760 ? 0 : 1) + " MB" : Math.max(1, Math.round(n / 1024)) + " KB" }
    div(class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8", id="fileStorage")
        a(href="/", class="text-sm text-indigo-600 hover:underline inline-flex items-center gap-1")
            i(data-lucide="arrow-left", class="w-4 h-4")
            | Menu chính
        h1(class="mt-3 text-2xl font-bold text-gray-900") Lưu trữ file
        p(class="mt-1 text-sm text-gray-500") Lưu tài liệu Word, Excel, PowerPoint, PDF và ảnh. File được mã hoá; file nặng tự chia nhỏ rồi lưu lần lượt vào các repo theo thứ tự repo được tạo. Khi tải về, trình duyệt của bạn tự giải mã — không qua máy chủ.
        nav(class="mt-2 text-sm text-gray-600 flex flex-wrap items-center gap-1")
            a(href=base, class="text-indigo-600 hover:underline") codes/files
            each p, i in parts
                span /
                a(href=base + "?dir=" + encodeURIComponent(parts.slice(0, i + 1).join("/")), class="text-indigo-600 hover:underline")= p
        div(class="mt-5 flex flex-wrap gap-3")
            button(id="btnNewFolder", class="px-4 py-2 rounded-lg bg-white border border-gray-300 text-sm font-medium hover:bg-gray-50") + Thư mục mới
            if files.length
                button(id="btnPublicAll", class="px-4 py-2 rounded-lg bg-white border border-emerald-300 text-emerald-700 text-sm font-medium hover:bg-emerald-50", title="Bật công khai cho mọi file trong thư mục này") Công khai tất cả
                button(id="btnPrivateAll", class="px-4 py-2 rounded-lg bg-white border border-gray-300 text-gray-700 text-sm font-medium hover:bg-gray-50", title="Chuyển mọi file trong thư mục này về riêng tư") Riêng tư tất cả
            - var folderHref = "/f/d?u=" + encodeURIComponent(uid) + "&d=" + encodeURIComponent(dir)
            button(id="btnShareFolder", data-shared=shared ? "1" : "0", title=shared ? "Thư mục đang được chia sẻ — bấm để thôi chia sẻ" : "Bật trang xem thư mục công khai — duyệt cả thư mục con và file, chỉ hiện các file đã bật công khai", class="px-4 py-2 rounded-lg bg-white border text-sm font-medium " + (shared ? "border-emerald-300 text-emerald-700 hover:bg-emerald-50" : "border-gray-300 text-gray-700 hover:bg-gray-50")) #{shared ? "Đang chia sẻ thư mục" : "Chia sẻ thư mục"}
            if shared
                a(href=folderHref, target="_blank", rel="noopener", class="px-3 py-2 text-sm text-emerald-700 hover:underline") Mở trang thư mục
                button(type="button", id="btnCopyFolder", data-copy=folderHref, class="px-3 py-2 text-sm text-emerald-700 hover:underline") Sao chép link thư mục
            if dir
                button(id="btnDelFolder", class="px-4 py-2 rounded-lg bg-white border border-red-300 text-red-600 text-sm font-medium hover:bg-red-50") Xoá thư mục này
        if repos && repos.length
            div(class="mt-4 bg-white border border-gray-200 rounded-xl px-3 py-2 text-sm")
                div(class="flex items-center gap-2 text-gray-600")
                    i(data-lucide="github", class="w-4 h-4 shrink-0")
                    span Link GitHub của thư mục này — đủ #{repos.length} repo chứa dữ liệu (file nặng được chia nhỏ qua nhiều repo):
                each g in repos
                    div(class="mt-1 flex items-center gap-2 pl-6")
                        a(href=g.url, target="_blank", rel="noopener noreferrer", class="flex-1 min-w-0 truncate text-indigo-600 hover:underline font-mono text-xs", title=g.url)= g.repo + " — " + g.files + " file"
                        button(type="button", class="px-2 py-0.5 rounded-lg bg-gray-100 text-xs font-medium hover:bg-gray-200 whitespace-nowrap", data-copyabs=g.url) Sao chép
        p(class="mt-2 text-xs text-gray-500") Mặc định mọi file là <b>riêng tư</b> (chỉ bạn xem). Bấm nhãn trạng thái của từng file để bật <b>công khai</b>, rồi gửi link cho người khác — ai có link đều xem được (ảnh, PDF xem thẳng; Word/Excel/PowerPoint tải về).

        //- tìm kiếm
        div(class="mt-4 flex flex-wrap items-center gap-2")
            div(class="relative flex-1 min-w-[14rem]")
                i(data-lucide="search", class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2")
                input(type="search", id="fsSearch", placeholder="Tìm file hoặc thư mục theo tên (không cần gõ dấu)…", autocomplete="off", class="w-full rounded-lg border border-gray-300 bg-white pl-9 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-300")
            button(type="button", id="btnSearchAll", class="px-4 py-2 rounded-lg bg-white border border-indigo-300 text-indigo-700 text-sm font-medium hover:bg-indigo-50") Tìm trong mọi thư mục
        div(id="fsResults", class="mt-3 hidden bg-white rounded-2xl border border-indigo-200 divide-y divide-gray-100")

        //- danh sách
        div(class="mt-5 bg-white rounded-2xl border border-gray-200 divide-y divide-gray-100")
            if dir
                - var up = parts.slice(0, -1).join("/")
                a(href=base + (up ? "?dir=" + encodeURIComponent(up) : ""), class="flex items-center gap-3 px-4 py-3 hover:bg-gray-50 text-gray-600")
                    i(data-lucide="corner-left-up", class="w-4 h-4")
                    | ..
            each f in folders
                div(class="fs-row flex items-center gap-3 px-4 py-3 hover:bg-gray-50", data-name=f)
                    i(data-lucide="folder", class="w-4 h-4 text-amber-500")
                    a(href=base + "?dir=" + encodeURIComponent((dir ? dir + "/" : "") + f), class="flex-1 font-medium text-gray-900 hover:text-indigo-600")= f
            each f in files
                - var k = KIND[f.kind] || KIND.office
                - var shareHref = "/f?u=" + encodeURIComponent(uid) + "&d=" + encodeURIComponent(dir) + "&n=" + encodeURIComponent(f.name)
                div(class="fs-row flex flex-wrap items-center gap-3 px-4 py-3 hover:bg-gray-50", data-name=f.name)
                    i(data-lucide=k[2], class="w-4 h-4 text-gray-500")
                    span(class="flex-1 min-w-[10rem] text-gray-900 break-all")= f.name
                    span(class="text-xs rounded-full px-2 py-0.5 " + k[1])= k[0]
                    span(class="text-xs text-gray-500")= fmt(f.size)
                    if f.parts > 1
                        span(class="text-xs text-gray-500", title=f.repos.length ? "Các phần nằm ở: " + f.repos.join(" → ") : "") #{f.parts} phần#{f.repos.length > 1 ? " · " + f.repos.length + " repo" : ""}
                    button(type="button", data-vis=f.name, data-public=f.public ? "1" : "0", title=f.public ? "Đang công khai — bấm để chuyển về riêng tư" : "Đang riêng tư — bấm để công khai", class="text-xs rounded-full px-2.5 py-0.5 border " + (f.public ? "border-emerald-300 bg-emerald-50 text-emerald-700" : "border-gray-300 bg-gray-50 text-gray-600")) #{f.public ? "Công khai" : "Riêng tư"}
                    if f.public
                        a(href=shareHref, target="_blank", rel="noopener", class="text-xs text-emerald-700 hover:underline") Mở link
                        button(type="button", class="text-xs text-emerald-700 hover:underline", data-copy=shareHref) Sao chép link
                    if f.github && f.github.length
                        span(class="text-xs text-gray-500") GitHub:
                            each g in f.github
                                a(href=g.url, target="_blank", rel="noopener noreferrer", class="ml-1 text-indigo-600 hover:underline", title="Mở thư mục chứa các phần mã hoá trên GitHub")= g.repo + (f.parts > 1 ? " (" + g.parts + " phần)" : "")
                    if f.kind === "text" && f.size <= limits.textEdit
                        button(type="button", class="text-xs text-indigo-600 hover:underline", data-edit=f.name)= canUpload ? "Xem / Sửa" : "Xem"
                    button(type="button", class="text-xs text-indigo-600 hover:underline", data-dl=f.name) Tải
                    button(type="button", class="text-xs text-gray-600 hover:underline", data-ren=f.name) Đổi tên
                    button(type="button", class="text-xs text-red-500 hover:underline", data-del=f.name) Xoá
            if !folders.length && !files.length
                div(class="px-4 py-10 text-center text-gray-500 text-sm") Thư mục trống. Hãy tải file lên hoặc tạo thư mục.

        //- tải lên
        h2(class="mt-8 text-lg font-semibold text-gray-900") Tải file lên
        if !canUpload
            div(class="mt-3 rounded-xl border border-amber-300 bg-amber-50 text-amber-900 text-sm px-4 py-3", id="upDenied")= denyMessage
        else
            div(id="upNotice", class="mt-3 hidden rounded-xl border border-amber-300 bg-amber-50 text-amber-900 text-xs px-3 py-2")
            div(id="upDrop", class="mt-3 rounded-2xl border-2 border-dashed border-gray-300 bg-white px-4 py-8 text-center")
                p(class="text-sm font-medium") Kéo thả file vào đây hoặc
                    label(class="ml-1 underline cursor-pointer text-indigo-600")
                        | chọn file
                        input(type="file", id="upInput", multiple, class="hidden", accept=accept)
            ul(class="mt-2 text-xs text-gray-500 list-disc pl-5 space-y-1")
                li Nhận: Word (#{exts.word.join(", ")}), Excel (#{exts.excel.join(", ")}), PowerPoint (#{exts.powerpoint.join(", ")}), PDF, văn bản (.txt — xem và sửa được ngay trên web), ảnh (#{exts.image.join(", ")}) và một số file Office khác (#{exts.office.join(", ")}).
                li Tối đa #{fmt(limits.maxFile)} mỗi file. File được cắt thành các phần #{fmt(limits.part)}, mã hoá từng phần; đứt giữa chừng thì chọn lại đúng file đó để làm tiếp.
                li Các phần ghi vào repo đang dùng; repo đầy thì tự tạo repo kế tiếp và ghi tiếp theo thứ tự.
            div(id="upList", class="mt-3 grid gap-2")
    //- Xem / sửa file .txt ngay trên web (giải mã trong trình duyệt; lưu = mã hoá lại và ghi đè cùng tên)
    div(id="edBox", class="hidden fixed inset-0 z-50 bg-black/40 flex items-center justify-center p-4")
        div(class="bg-white rounded-2xl shadow-xl w-full max-w-3xl flex flex-col max-h-[90vh]")
            div(class="flex items-center gap-3 px-4 py-3 border-b border-gray-100")
                h3(id="edTitle", class="flex-1 font-semibold text-gray-900 break-all")
                button(type="button", id="edClose", class="text-sm text-gray-500 hover:text-gray-800") Đóng
            textarea(id="edText", spellcheck="false", class="flex-1 min-h-[50vh] w-full p-4 font-mono text-sm leading-relaxed focus:outline-none resize-none")
            div(class="flex items-center gap-3 px-4 py-3 border-t border-gray-100")
                span(id="edMsg", class="flex-1 text-xs text-gray-500")
                button(type="button", id="edSave", class="px-4 py-2 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700") Lưu
    script#payload(type="application/json")!= payloadJson
    script(src="/js/mnhaFiles.js")
    script(src="/js/fileStorage.js")
