extends ../layout

block content
    - var base = "/code/files"
    - var parts = dir ? dir.split("/") : []
    - var KIND = { word: ["Word", "text-blue-600 bg-blue-50", "file-text"], excel: ["Excel", "text-emerald-700 bg-emerald-50", "file-spreadsheet"], powerpoint: ["PowerPoint", "text-orange-600 bg-orange-50", "presentation"], office: ["Office", "text-indigo-600 bg-indigo-50", "file"], pdf: ["PDF", "text-red-600 bg-red-50", "file-text"], image: ["Ảnh", "text-purple-600 bg-purple-50", "image"] }
    - function fmt(n) { return n >= 1048576 ? (n / 1048576).toFixed(n >= 10485760 ? 0 : 1) + " MB" : Math.max(1, Math.round(n / 1024)) + " KB" }
    div(class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8", id="fileStorage")
        a(href="/", class="text-sm text-indigo-600 hover:underline inline-flex items-center gap-1")
            i(data-lucide="arrow-left", class="w-4 h-4")
            | Menu chính
        h1(class="mt-3 text-2xl font-bold text-gray-900") Lưu trữ file
        p(class="mt-1 text-sm text-gray-500") Lưu tài liệu Word, Excel, PowerPoint, PDF và ảnh. File được mã hoá; file nặng tự chia nhỏ rồi lưu lần lượt vào các repo theo thứ tự repo được tạo.
        nav(class="mt-2 text-sm text-gray-600 flex flex-wrap items-center gap-1")
            a(href=base, class="text-indigo-600 hover:underline") codes/files
            each p, i in parts
                span /
                a(href=base + "?dir=" + encodeURIComponent(parts.slice(0, i + 1).join("/")), class="text-indigo-600 hover:underline")= p
        div(class="mt-5 flex flex-wrap gap-3")
            button(id="btnNewFolder", class="px-4 py-2 rounded-lg bg-white border border-gray-300 text-sm font-medium hover:bg-gray-50") + Thư mục mới
            if dir
                button(id="btnDelFolder", class="px-4 py-2 rounded-lg bg-white border border-red-300 text-red-600 text-sm font-medium hover:bg-red-50") Xoá thư mục này

        //- danh sách
        div(class="mt-5 bg-white rounded-2xl border border-gray-200 divide-y divide-gray-100")
            if dir
                - var up = parts.slice(0, -1).join("/")
                a(href=base + (up ? "?dir=" + encodeURIComponent(up) : ""), class="flex items-center gap-3 px-4 py-3 hover:bg-gray-50 text-gray-600")
                    i(data-lucide="corner-left-up", class="w-4 h-4")
                    | ..
            each f in folders
                div(class="flex items-center gap-3 px-4 py-3 hover:bg-gray-50")
                    i(data-lucide="folder", class="w-4 h-4 text-amber-500")
                    a(href=base + "?dir=" + encodeURIComponent((dir ? dir + "/" : "") + f), class="flex-1 font-medium text-gray-900 hover:text-indigo-600")= f
            each f in files
                - var k = KIND[f.kind] || KIND.office
                div(class="flex flex-wrap items-center gap-3 px-4 py-3 hover:bg-gray-50")
                    i(data-lucide=k[2], class="w-4 h-4 text-gray-500")
                    span(class="flex-1 min-w-[10rem] text-gray-900 break-all")= f.name
                    span(class="text-xs rounded-full px-2 py-0.5 " + k[1])= k[0]
                    span(class="text-xs text-gray-500")= fmt(f.size)
                    if f.parts > 1
                        span(class="text-xs text-gray-500", title=f.repos.length ? "Các phần nằm ở: " + f.repos.join(" → ") : "") #{f.parts} phần#{f.repos.length > 1 ? " · " + f.repos.length + " repo" : ""}
                    button(type="button", class="text-xs text-indigo-600 hover:underline", data-dl=f.name) Tải
                    button(type="button", class="text-xs text-gray-600 hover:underline", data-ren=f.name) Đổi tên
                    button(type="button", class="text-xs text-red-500 hover:underline", data-del=f.name) Xoá
            if !folders.length && !files.length
                div(class="px-4 py-10 text-center text-gray-500 text-sm") Thư mục trống. Hãy tải file lên hoặc tạo thư mục.

        //- tải lên
        h2(class="mt-8 text-lg font-semibold text-gray-900") Tải file lên
        if !canUpload
            div(class="mt-3 rounded-xl border border-amber-300 bg-amber-50 text-amber-900 text-sm px-4 py-3", id="upDenied")= denyMessage
        else
            div(id="upNotice", class="mt-3 hidden rounded-xl border border-amber-300 bg-amber-50 text-amber-900 text-xs px-3 py-2")
            div(id="upDrop", class="mt-3 rounded-2xl border-2 border-dashed border-gray-300 bg-white px-4 py-8 text-center")
                p(class="text-sm font-medium") Kéo thả file vào đây hoặc
                    label(class="ml-1 underline cursor-pointer text-indigo-600")
                        | chọn file
                        input(type="file", id="upInput", multiple, class="hidden", accept=accept)
            ul(class="mt-2 text-xs text-gray-500 list-disc pl-5 space-y-1")
                li Nhận: Word (#{exts.word.join(", ")}), Excel (#{exts.excel.join(", ")}), PowerPoint (#{exts.powerpoint.join(", ")}), PDF, ảnh (#{exts.image.join(", ")}) và một số file Office khác (#{exts.office.join(", ")}).
                li Tối đa #{fmt(limits.maxFile)} mỗi file. File được cắt thành các phần #{fmt(limits.part)}, mã hoá từng phần; đứt giữa chừng thì chọn lại đúng file đó để làm tiếp.
                li Các phần ghi vào repo đang dùng; repo đầy thì tự tạo repo kế tiếp và ghi tiếp theo thứ tự.
            div(id="upList", class="mt-3 grid gap-2")
    script#payload(type="application/json")!= payloadJson
    script(src="/js/fileStorage.js")
