extends ../layout

block content
    link(rel="stylesheet", href="/css/html.css")
    div(class="pl-wrap")
        div(class="flex items-center gap-3 px-4 h-11 bg-slate-900 border-b border-slate-800 text-sm")
            a(href=backUrl, class="text-sky-400 hover:underline inline-flex items-center gap-1")
                i(data-lucide="arrow-left", class="w-4 h-4")
                | Quay lại
            span(class="text-slate-400 truncate")= heading
            span(id="plNode", class="ml-auto text-xs text-emerald-400 whitespace-nowrap")
        div(class="pl-main")
            div(class="pl-stage", id="plStage")
                div(class="pl-empty", id="plEmpty") Chưa chọn gì.
            aside(class="pl-side", id="plSide")
    script#payload(type="application/json")!= payloadJson
    script(src="/js/mnhaMedia.js")
    script(src="/js/mediaPlayer.js")
