extends ../layout

block content
    link(rel="stylesheet", href="/css/word.css")
    link(rel="stylesheet", href="/css/word-doc.css")
    div(class="wd-app", id="wdApp")
        div(class="wd-topbar")
            a(href="/code/word", id="wdBack", class="wd-back", title="Quay lại danh sách tài liệu")
                i(data-lucide="arrow-left", class="w-4 h-4")
            div(class="wd-fileinfo")
                i(data-lucide="file-text", class="w-4 h-4 text-blue-700")
                span(class="wd-filename", id="wdTitle") #{file}
                span(class="wd-dirty hidden", id="wdDirty") ● chưa lưu
                span(class="wd-enc") 🔒 mã hoá
            div(class="wd-topactions")
                span(class="wd-status", id="wdStatus")
                button(type="button", id="wdPublicBtn", class="wd-btn wd-btn-ghost", data-public=isPublic ? "1" : "0", title="Bật/tắt xem công khai bằng link /w")
                    i(data-lucide=isPublic ? "globe" : "lock", class="w-4 h-4")
                    span(id="wdPublicText")= isPublic ? "Công khai" : "Riêng tư"
                button(type="button", id="wdCopyLink", class="wd-btn wd-btn-ghost " + (isPublic ? "" : "hidden"), title="Sao chép link công khai")
                    i(data-lucide="link", class="w-4 h-4")
                    span Sao chép link
                button(type="button", id="wdDownload", class="wd-btn wd-btn-ghost", title="Lưu rồi tải Word (.docx) về máy")
                    i(data-lucide="download", class="w-4 h-4")
                    span Tải về máy
                button(type="button", id="wdPrint", class="wd-btn wd-btn-ghost", title="In (Ctrl+P)")
                    i(data-lucide="printer", class="w-4 h-4")
                button(type="button", id="wdSave", class="wd-btn wd-btn-primary", title="Lưu (Ctrl+S)")
                    i(data-lucide="save", class="w-4 h-4")
                    span Lưu
        div(class="wd-ribbon", id="wdRibbon")
            div(class="wd-tabstrip", role="tablist", aria-label="Thẻ ribbon Word")
                button(type="button", class="wd-tab", data-tab="file", role="tab") Tệp
                button(type="button", class="wd-tab active", data-tab="home", role="tab") Trang đầu
                button(type="button", class="wd-tab", data-tab="insert", role="tab") Chèn
                button(type="button", class="wd-tab", data-tab="layout", role="tab") Bố trí
                button(type="button", class="wd-tab", data-tab="references", role="tab") Tham khảo
                button(type="button", class="wd-tab", data-tab="review", role="tab") Xem lại
                button(type="button", class="wd-tab", data-tab="view", role="tab") Xem
                button(type="button", class="wd-tab", data-tab="help", role="tab") Trợ giúp
                button(type="button", class="wd-tab wd-tab-ctx", id="wdTabShape", data-tab="shape", role="tab") Định dạng hình
            div(class="wd-panes")
                //- ---------------------------------------------------------- Tệp
                div(class="wd-pane", data-pane="file", role="tabpanel")
                    div(class="wd-group")
                        div(class="wd-group-body wd-row")
                            button(type="button", class="wd-big", data-action="save", title="Lưu (Ctrl+S)")
                                i(data-lucide="save", class="w-5 h-5")
                                span Lưu
                            button(type="button", class="wd-big", data-action="download", title="Tải .docx về máy")
                                i(data-lucide="download", class="w-5 h-5")
                                span Tải về
                            button(type="button", class="wd-big", data-action="print", title="In (Ctrl+P)")
                                i(data-lucide="printer", class="w-5 h-5")
                                span In
                        div(class="wd-group-label") Tệp
                    div(class="wd-group")
                        div(class="wd-group-body wd-row")
                            button(type="button", class="wd-big", data-action="new-doc", title="Tạo tài liệu mới")
                                i(data-lucide="file-plus-2", class="w-5 h-5")
                                span Tài liệu mới
                            button(type="button", class="wd-big", data-action="open-doc", title="Mở danh sách tài liệu")
                                i(data-lucide="folder-open", class="w-5 h-5")
                                span Mở
                        div(class="wd-group-label") Mở
                    div(class="wd-group")
                        div(class="wd-group-body wd-row")
                            button(type="button", class="wd-big", data-action="public", title="Bật/tắt link công khai /w")
                                i(data-lucide=isPublic ? "globe" : "lock", class="w-5 h-5")
                                span(id="wdRibbonPublicText")= isPublic ? "Công khai" : "Riêng tư"
                            button(type="button", class="wd-big", data-action="copy-link", title="Sao chép link công khai")
                                i(data-lucide="link", class="w-5 h-5")
                                span Sao chép link
                        div(class="wd-group-label") Chia sẻ
                    div(class="wd-group")
                        div(class="wd-group-body wd-row")
                            button(type="button", class="wd-big", data-action="about", title="Thông tin tài liệu")
                                i(data-lucide="info", class="w-5 h-5")
                                span Thông tin
                        div(class="wd-group-label") Thông tin
                //- ---------------------------------------------------------- Trang đầu
                div(class="wd-pane active", data-pane="home", role="tabpanel")
                    div(class="wd-group")
                        div(class="wd-group-body")
                            div(class="wd-row")
                                button(type="button", class="wd-ic", data-cmd="paste", title="Dán (Ctrl+V)")
                                    i(data-lucide="clipboard-paste", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-cmd="cut", title="Cắt (Ctrl+X)")
                                    i(data-lucide="scissors", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-cmd="copy", title="Sao chép (Ctrl+C)")
                                    i(data-lucide="copy", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-action="format-painter", title="Sao chép định dạng")
                                    i(data-lucide="paintbrush", class="w-4 h-4")
                        div(class="wd-group-label") Bảng tạm
                    div(class="wd-group wd-group-font")
                        div(class="wd-group-body")
                            div(class="wd-row")
                                select(id="wdFont", class="wd-select wd-font-select", title="Phông chữ")
                                    option(value="Aptos") Aptos
                                    option(value="Calibri") Calibri
                                    option(value="Arial") Arial
                                    option(value="'Times New Roman'") Times New Roman
                                    option(value="Cambria") Cambria
                                    option(value="'Courier New'") Courier New
                                    option(value="Georgia") Georgia
                                    option(value="Verdana") Verdana
                                    option(value="Tahoma") Tahoma
                                select(id="wdSize", class="wd-select wd-size-select", title="Cỡ chữ (pt)")
                                    each s in [8, 9, 10, 11, 12, 14, 16, 18, 20, 22, 24, 28, 32, 36, 48, 72]
                                        option(value=s, selected=(s === 12))= s
                                button(type="button", class="wd-ic", data-action="grow-font", title="Tăng cỡ chữ")
                                    i(data-lucide="a-arrow-up", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-action="shrink-font", title="Giảm cỡ chữ")
                                    i(data-lucide="a-arrow-down", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-cmd="removeFormat", id="wdClear", title="Xoá định dạng")
                                    i(data-lucide="eraser", class="w-4 h-4")
                            div(class="wd-row")
                                button(type="button", class="wd-ic wd-strong", data-cmd="bold", title="Đậm (Ctrl+B)")
                                    i(data-lucide="bold", class="w-4 h-4")
                                button(type="button", class="wd-ic wd-italic", data-cmd="italic", title="Nghiêng (Ctrl+I)")
                                    i(data-lucide="italic", class="w-4 h-4")
                                button(type="button", class="wd-ic wd-underline", data-cmd="underline", title="Gạch chân (Ctrl+U)")
                                    i(data-lucide="underline", class="w-4 h-4")
                                button(type="button", class="wd-ic wd-strike", data-cmd="strikeThrough", title="Gạch ngang")
                                    i(data-lucide="strikethrough", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-cmd="superscript", title="Chỉ số trên")
                                    i(data-lucide="superscript", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-cmd="subscript", title="Chỉ số dưới")
                                    i(data-lucide="subscript", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-action="change-case", title="Đổi chữ hoa/thường")
                                    i(data-lucide="case-sensitive", class="w-4 h-4")
                                label(class="wd-color", title="Màu chữ")
                                    span A
                                    input(type="color", id="wdColor", value="#1f2937")
                                label(class="wd-color wd-hilite", title="Tô nền")
                                    span ▮
                                    input(type="color", id="wdHilite", value="#fff59d")
                        div(class="wd-group-label") Phông chữ
                    div(class="wd-group")
                        div(class="wd-group-body")
                            div(class="wd-row")
                                button(type="button", class="wd-ic", data-cmd="insertUnorderedList", title="Danh sách chấm")
                                    i(data-lucide="list", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-cmd="insertOrderedList", title="Danh sách số")
                                    i(data-lucide="list-ordered", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-cmd="outdent", title="Giảm thụt lề")
                                    i(data-lucide="outdent", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-cmd="indent", title="Tăng thụt lề")
                                    i(data-lucide="indent", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-action="para-border", title="Đường viền đoạn")
                                    i(data-lucide="square-dashed-bottom", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-action="para-shading", title="Tô nền đoạn")
                                    i(data-lucide="paint-bucket", class="w-4 h-4")
                            div(class="wd-row")
                                button(type="button", class="wd-ic", data-cmd="justifyLeft", title="Căn trái")
                                    i(data-lucide="align-left", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-cmd="justifyCenter", title="Căn giữa")
                                    i(data-lucide="align-center", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-cmd="justifyRight", title="Căn phải")
                                    i(data-lucide="align-right", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-cmd="justifyFull", title="Căn đều")
                                    i(data-lucide="align-justify", class="w-4 h-4")
                                select(id="wdLineHeight", class="wd-select wd-line-select", title="Giãn dòng")
                                    option(value="1") 1,0
                                    option(value="1.15") 1,15
                                    option(value="1.5") 1,5
                                    option(value="2") 2,0
                        div(class="wd-group-label") Đoạn văn
                    div(class="wd-group")
                        div(class="wd-group-body")
                            div(class="wd-row")
                                select(id="wdBlock", class="wd-select wd-block-select", title="Kiểu đoạn")
                                    option(value="P") Văn bản
                                    option(value="H1") Tiêu đề 1
                                    option(value="H2") Tiêu đề 2
                                    option(value="H3") Tiêu đề 3
                                    option(value="H4") Tiêu đề 4
                                    option(value="BLOCKQUOTE") Trích dẫn
                                    option(value="PRE") Đoạn mã
                            div(class="wd-row")
                                button(type="button", class="wd-style-btn", data-style="P", title="Kiểu thường") Văn bản
                                button(type="button", class="wd-style-btn", data-style="H1", title="Tiêu đề 1") Tiêu đề 1
                                button(type="button", class="wd-style-btn", data-style="H2", title="Tiêu đề 2") Tiêu đề 2
                                button(type="button", class="wd-style-btn", data-style="BLOCKQUOTE", title="Trích dẫn") Trích dẫn
                        div(class="wd-group-label") Kiểu
                    div(class="wd-group")
                        div(class="wd-group-body")
                            div(class="wd-row")
                                button(type="button", class="wd-ic", data-action="find", title="Tìm (Ctrl+F)")
                                    i(data-lucide="search", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-action="replace", title="Thay thế (Ctrl+H)")
                                    i(data-lucide="replace", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-cmd="selectAll", title="Chọn tất cả (Ctrl+A)")
                                    i(data-lucide="mouse-pointer-square", class="w-4 h-4")
                        div(class="wd-group-label") Chỉnh sửa
                //- ---------------------------------------------------------- Chèn
                div(class="wd-pane", data-pane="insert", role="tabpanel")
                    div(class="wd-group")
                        div(class="wd-group-body wd-row")
                            button(type="button", class="wd-big", data-action="cover", title="Trang bìa")
                                i(data-lucide="book-cover", class="w-5 h-5")
                                span Trang bìa
                            button(type="button", class="wd-big", data-action="blank-page", title="Trang trống")
                                i(data-lucide="file-plus", class="w-5 h-5")
                                span Trang trống
                            button(type="button", class="wd-big", id="wdPageBreak", title="Ngắt trang")
                                i(data-lucide="file-minus-2", class="w-5 h-5")
                                span Ngắt trang
                        div(class="wd-group-label") Trang
                    div(class="wd-group")
                        div(class="wd-group-body wd-row")
                            button(type="button", class="wd-big", id="wdTable", title="Chèn bảng")
                                i(data-lucide="table", class="w-5 h-5")
                                span Bảng
                            button(type="button", class="wd-big", data-action="quick-table", title="Bảng nhanh 3×3")
                                i(data-lucide="table-2", class="w-5 h-5")
                                span Bảng nhanh
                        div(class="wd-group-label") Bảng
                    div(class="wd-group")
                        div(class="wd-group-body wd-row")
                            button(type="button", class="wd-big", id="wdImage", title="Chèn ảnh")
                                i(data-lucide="image-plus", class="w-5 h-5")
                                span Hình ảnh
                            button(type="button", class="wd-big", id="wdShapeMenu", title="Hình khối — bấm để chọn hoặc kéo thả vào bất kỳ chỗ nào của trang")
                                i(data-lucide="shapes", class="w-5 h-5")
                                span Hình khối
                            button(type="button", class="wd-big", data-action="icon", title="Chèn biểu tượng")
                                i(data-lucide="smile", class="w-5 h-5")
                                span Biểu tượng
                        div(class="wd-group-label") Hình minh hoạ
                    div(class="wd-group")
                        div(class="wd-group-body")
                            div(class="wd-row")
                                button(type="button", class="wd-ic", id="wdLink", title="Chèn liên kết")
                                    i(data-lucide="link-2", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-action="bookmark", title="Đánh dấu vị trí")
                                    i(data-lucide="bookmark", class="w-4 h-4")
                            div(class="wd-row")
                                button(type="button", class="wd-ic", id="wdRule", title="Đường kẻ ngang")
                                    i(data-lucide="minus", class="w-4 h-4")
                        div(class="wd-group-label") Liên kết
                    div(class="wd-group")
                        div(class="wd-group-body")
                            div(class="wd-row")
                                button(type="button", class="wd-ic", data-action="header", title="Đầu trang")
                                    i(data-lucide="panel-top", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-action="footer", title="Chân trang")
                                    i(data-lucide="panel-bottom", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-action="page-number", title="Số trang")
                                    i(data-lucide="hash", class="w-4 h-4")
                        div(class="wd-group-label") Đầu & chân trang
                    div(class="wd-group")
                        div(class="wd-group-body")
                            div(class="wd-row")
                                button(type="button", class="wd-ic", data-action="textbox", title="Hộp văn bản")
                                    i(data-lucide="text-cursor-input", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-action="date", title="Ngày giờ")
                                    i(data-lucide="calendar", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-action="symbol", title="Ký tự đặc biệt")
                                    i(data-lucide="omega", class="w-4 h-4")
                        div(class="wd-group-label") Văn bản
                //- ---------------------------------------------------------- Bố trí
                div(class="wd-pane", data-pane="layout", role="tabpanel")
                    div(class="wd-group")
                        div(class="wd-group-body")
                            div(class="wd-row")
                                select(id="wdPageSize", class="wd-select", title="Khổ giấy")
                                    option(value="A4") A4
                                    option(value="Letter") Letter
                                select(id="wdOrient", class="wd-select", title="Hướng giấy")
                                    option(value="portrait") Dọc
                                    option(value="landscape") Ngang
                                select(id="wdMargin", class="wd-select", title="Lề")
                                    option(value="normal") Lề thường
                                    option(value="narrow") Lề hẹp
                                    option(value="wide") Lề rộng
                            div(class="wd-row")
                                button(type="button", class="wd-ic", data-action="page-setup", title="Thiết lập trang")
                                    i(data-lucide="settings-2", class="w-4 h-4")
                                label(class="wd-color", title="Màu nền trang")
                                    span ▤
                                    input(type="color", id="wdPageColor", value="#ffffff")
                        div(class="wd-group-label") Thiết lập trang
                    div(class="wd-group")
                        div(class="wd-group-body")
                            div(class="wd-row")
                                button(type="button", class="wd-ic", data-action="indent-left", title="Tăng lề trái")
                                    i(data-lucide="arrow-right-to-line", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-action="indent-right", title="Giảm lề trái")
                                    i(data-lucide="arrow-left-to-line", class="w-4 h-4")
                                select(id="wdColumns", class="wd-select", title="Chia cột")
                                    option(value="1") 1 cột
                                    option(value="2") 2 cột
                                    option(value="3") 3 cột
                            div(class="wd-row")
                                button(type="button", class="wd-ic", data-action="space-before", title="Tăng khoảng cách trên")
                                    i(data-lucide="arrow-up-to-line", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-action="space-after", title="Tăng khoảng cách dưới")
                                    i(data-lucide="arrow-down-to-line", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-cmd="indent", title="Thụt lề")
                                    i(data-lucide="indent", class="w-4 h-4")
                        div(class="wd-group-label") Đoạn văn
                    div(class="wd-group")
                        div(class="wd-group-body")
                            div(class="wd-row")
                                button(type="button", class="wd-ic", data-action="watermark", title="Hình chìm")
                                    i(data-lucide="droplets", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-action="line-numbers", title="Số dòng")
                                    i(data-lucide="list-ordered", class="w-4 h-4")
                        div(class="wd-group-label") Nền trang
                    div(class="wd-group")
                        div(class="wd-group-body")
                            div(class="wd-row")
                                button(type="button", class="wd-ic", data-action="bring-front", title="Đưa lên trước")
                                    i(data-lucide="bring-to-front", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-action="send-back", title="Đưa ra sau")
                                    i(data-lucide="send-to-back", class="w-4 h-4")
                        div(class="wd-group-label") Sắp xếp
                //- ---------------------------------------------------------- Tham khảo
                div(class="wd-pane", data-pane="references", role="tabpanel")
                    div(class="wd-group")
                        div(class="wd-group-body wd-row")
                            button(type="button", class="wd-big", data-action="toc", title="Chèn mục lục")
                                i(data-lucide="list-tree", class="w-5 h-5")
                                span Mục lục
                            button(type="button", class="wd-big", data-action="toc-update", title="Cập nhật mục lục")
                                i(data-lucide="refresh-cw", class="w-5 h-5")
                                span Cập nhật
                        div(class="wd-group-label") Mục lục
                    div(class="wd-group")
                        div(class="wd-group-body")
                            div(class="wd-row")
                                button(type="button", class="wd-ic", data-action="footnote", title="Chú thích cuối trang")
                                    i(data-lucide="superscript", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-action="endnote", title="Chú thích cuối tài liệu")
                                    i(data-lucide="file-text", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-action="next-footnote", title="Chú thích tiếp theo")
                                    i(data-lucide="arrow-down", class="w-4 h-4")
                        div(class="wd-group-label") Chú thích
                    div(class="wd-group")
                        div(class="wd-group-body")
                            div(class="wd-row")
                                button(type="button", class="wd-ic", data-action="citation", title="Trích dẫn nguồn")
                                    i(data-lucide="quote", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-action="bibliography", title="Danh mục tài liệu tham khảo")
                                    i(data-lucide="book-open", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-action="manage-sources", title="Quản lý nguồn")
                                    i(data-lucide="library", class="w-4 h-4")
                        div(class="wd-group-label") Trích dẫn
                    div(class="wd-group")
                        div(class="wd-group-body")
                            div(class="wd-row")
                                button(type="button", class="wd-ic", data-action="caption", title="Chú thích hình/bảng")
                                    i(data-lucide="tag", class="w-4 h-4")
                                button(type="button", class="wd-ic", data-action="cross-reference", title="Tham chiếu chéo")
                                    i(data-lucide="link", class="w-4 h-4")
                        div(class="wd-group-label") Chú thích ảnh
                    div(class="wd-group")
                        div(class="wd-group-body")
                            div(class="wd-row")
                                button(type="button", class="wd-ic", data-action="index-entry", title="Đánh dấu mục tra cứu")
                                    i(data-lucide="book-marked", class="w-4 h-4")
